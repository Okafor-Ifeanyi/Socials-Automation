# ─── Content generation ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Model used for generation and voice distillation.
# Defaults to claude-opus-5. Use claude-sonnet-5 for a cheaper run.
CLAUDE_MODEL=claude-opus-5
GENERATION_EFFORT=medium
DISTILL_EFFORT=high

# ─── Publishing (Late.dev) ───────────────────────────────────────────────────
LATE_API_KEY=sk_...
LATE_TWITTER_ACCOUNT_ID=
LATE_LINKEDIN_ACCOUNT_ID=

# ─── Behaviour ───────────────────────────────────────────────────────────────
# Require `npm run review` before anything is published. Strongly recommended:
# the review step is also where the feedback that improves the voice is captured.
REQUIRE_APPROVAL=true

# now | schedule | draft. Used by the automated poster.
POST_MODE=draft

# Posting slot, in real local time — not the server's timezone.
POST_TIMEZONE=UTC
POST_HOUR=9

# Hours to wait after publishing before engagement numbers are read back.
OUTCOME_DELAY_HOURS=48

# Jaccard similarity above which a draft counts as repeating an earlier post.
SIMILARITY_THRESHOLD=0.5

# Chance of choosing an untouched topic over a proven one.
TOPIC_EXPLORE_RATE=0.7

# Cap on accumulated voice rules; the oldest retire past this.
MAX_LEARNED_RULES=25

# ─── Paths ───────────────────────────────────────────────────────────────────
DATA_DIR=./data
TOPICS_FILE=./src/topics.json
LINKEDIN_CSV=./src/linkedInPosts.csv
X_CSV=./src/xPosts.csv
